PROJECT_NAME="AI Store System API"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & JWT
SECRET_KEY="replace_with_same_generated_random_value_in_both_env_files"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ai_store_db"

# CORS Origins
CORS_ORIGINS=["http://localhost:3000"]
